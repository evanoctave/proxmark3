TARGET12_XST_OPTS = $(XST_OPTS_BASE) $(XST_OPTS_AREA)  -p $(TARGET12_FPGA) -ofn $(TARGET12_NAME) $(TARGET12_OPTIONS)
TARGET13_XST_OPTS = $(XST_OPTS_BASE) $(XST_OPTS_AREA)  -p $(TARGET13_FPGA) -ofn $(TARGET13_NAME) $(TARGET13_OPTIONS)

